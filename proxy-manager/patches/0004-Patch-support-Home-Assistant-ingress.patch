diff --git a/docker/rootfs/etc/nginx/conf.d/production.conf.template b/docker/rootfs/etc/nginx/conf.d/production.conf.template
index 452609b..5568303 100644
--- a/docker/rootfs/etc/nginx/conf.d/production.conf.template
+++ b/docker/rootfs/etc/nginx/conf.d/production.conf.template
@@ -23,6 +23,14 @@ server {
 		proxy_send_timeout 15m;
 	}
 
+	# The interface loads its files relative to the page, so that it also works
+	# under the Home Assistant ingress path. A page opened at a nested route
+	# therefore asks for e.g. /nginx/assets/index.js; serve those files from
+	# the top level.
+	location ~ ^/(?!api/).+?/((?:assets|images)/.+)$ {
+		try_files /$1 =404;
+	}
+
 	location / {
 		index index.html;
 		if ($request_uri ~ ^/(.*)\.html$) {
