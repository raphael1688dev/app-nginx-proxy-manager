diff --git a/frontend/src/modules/BasePath.ts b/frontend/src/modules/BasePath.ts
new file mode 100644
index 0000000..b66a44d
--- /dev/null
+++ b/frontend/src/modules/BasePath.ts
@@ -0,0 +1,10 @@
+// Path prefix the interface is served under. It is empty when the interface
+// is served at the root of its own port, and the Home Assistant ingress path
+// (/api/hassio_ingress/<token>) when it is opened from the sidebar. The add-on's
+// ingress server writes that path into index.html.
+export const basePath = (
+	document.querySelector<HTMLMetaElement>('meta[name="ingress-path"]')?.content ?? ""
+).replace(/\/+$/, "");
+
+// Prefix an absolute path, such as /images/logo.svg, with the base path
+export const withBasePath = (path: string) => `${basePath}${path}`;
