diff --git a/frontend/src/modals/ApiTokenModal.tsx b/frontend/src/modals/ApiTokenModal.tsx
new file mode 100644
index 0000000..8f55edd
--- /dev/null
+++ b/frontend/src/modals/ApiTokenModal.tsx
@@ -0,0 +1,208 @@
+import EasyModal, { type InnerModalProps } from "ez-modal-react";
+import { type FormEvent, type ReactNode, useRef, useState } from "react";
+import { Alert } from "react-bootstrap";
+import Modal from "react-bootstrap/Modal";
+import { getToken, isTwoFactorChallenge, type TokenResponse, verify2FA } from "src/api/backend";
+import { Button } from "src/components";
+import { useLocaleState } from "src/context";
+import { useUser } from "src/hooks";
+import { formatDateTime, intl, T } from "src/locale";
+
+// The lifetimes the backend accepts for a token requested with a password
+const EXPIRY_OPTIONS = ["1d", "7d", "30d", "90d", "1y", "2y", "3y"];
+
+const showApiTokenModal = () => {
+	EasyModal.show(ApiTokenModal);
+};
+
+// The Clipboard API only exists on secure origins, and the admin interface is
+// usually served over plain http, so fall back to copying the selection.
+const copyText = async (field: HTMLTextAreaElement): Promise<boolean> => {
+	if (navigator.clipboard) {
+		try {
+			await navigator.clipboard.writeText(field.value);
+			return true;
+		} catch {
+			// Fall through to the selection
+		}
+	}
+	field.select();
+	return document.execCommand("copy");
+};
+
+const ApiTokenModal = EasyModal.create(({ visible, remove }: InnerModalProps) => {
+	const { data: currentUser } = useUser("me");
+	const { locale } = useLocaleState();
+	const [password, setPassword] = useState("");
+	const [code, setCode] = useState("");
+	const [expiry, setExpiry] = useState("30d");
+	const [challengeToken, setChallengeToken] = useState<string | null>(null);
+	const [result, setResult] = useState<TokenResponse | null>(null);
+	const [copied, setCopied] = useState<boolean | null>(null);
+	const [error, setError] = useState<ReactNode | null>(null);
+	const [isSubmitting, setIsSubmitting] = useState(false);
+	const tokenField = useRef<HTMLTextAreaElement>(null);
+
+	const onSubmit = async (e: FormEvent) => {
+		e.preventDefault();
+		if (isSubmitting || !currentUser) return;
+		setIsSubmitting(true);
+		setError(null);
+
+		try {
+			if (challengeToken) {
+				setResult(await verify2FA(challengeToken, code, expiry));
+			} else {
+				const response = await getToken(currentUser.email, password, expiry);
+				if (isTwoFactorChallenge(response)) {
+					setChallengeToken(response.challengeToken);
+				} else {
+					setResult(response);
+				}
+			}
+			setPassword("");
+		} catch (err: any) {
+			setError(<T id={err.message} />);
+		}
+		setIsSubmitting(false);
+	};
+
+	const onCopy = async () => {
+		if (tokenField.current) {
+			setCopied(await copyText(tokenField.current));
+		}
+	};
+
+	return (
+		<Modal show={visible} onHide={remove}>
+			<form onSubmit={onSubmit}>
+				<Modal.Header closeButton>
+					<Modal.Title>
+						<T id="user.api-tokens" />
+					</Modal.Title>
+				</Modal.Header>
+				<Modal.Body>
+					<Alert variant="danger" show={!!error} onClose={() => setError(null)} dismissible>
+						{error}
+					</Alert>
+					{result ? (
+						<>
+							<Alert variant="warning">
+								<T id="api-token.copy-now" />
+							</Alert>
+							<textarea
+								ref={tokenField}
+								className="form-control font-monospace"
+								rows={5}
+								value={result.token}
+								readOnly
+							/>
+							<div className="d-flex align-items-center mt-2">
+								<span className="text-secondary">
+									<T
+										id="expires.on"
+										data={{ date: formatDateTime(result.expires, locale) }}
+									/>
+								</span>
+								<Button className="ms-auto" onClick={onCopy}>
+									<T id="api-token.copy" />
+								</Button>
+							</div>
+							{copied === null ? null : (
+								<div className="small text-secondary mt-2">
+									<T id={copied ? "api-token.copied" : "api-token.copy-manually"} />
+								</div>
+							)}
+						</>
+					) : (
+						<>
+							<p className="text-secondary">
+								<T id="api-token.description" />
+							</p>
+							{challengeToken ? (
+								<div className="mb-3">
+									<label className="form-label" htmlFor="api-token-code">
+										<T id="login.2fa-code" />
+									</label>
+									<input
+										id="api-token-code"
+										className="form-control"
+										autoComplete="one-time-code"
+										inputMode="numeric"
+										required
+										minLength={6}
+										maxLength={8}
+										placeholder={intl.formatMessage({ id: "login.2fa-code-placeholder" })}
+										value={code}
+										onChange={(e) => setCode(e.target.value)}
+									/>
+								</div>
+							) : (
+								<>
+									<div className="mb-3">
+										<label className="form-label" htmlFor="api-token-password">
+											<T id="user.current-password" />
+										</label>
+										<input
+											id="api-token-password"
+											type="password"
+											className="form-control"
+											autoComplete="current-password"
+											required
+											value={password}
+											onChange={(e) => setPassword(e.target.value)}
+										/>
+									</div>
+									<div className="mb-3">
+										<label className="form-label" htmlFor="api-token-expiry">
+											<T id="api-token.expires-after" />
+										</label>
+										<select
+											id="api-token-expiry"
+											className="form-select"
+											value={expiry}
+											onChange={(e) => setExpiry(e.target.value)}
+										>
+											{EXPIRY_OPTIONS.map((option) => (
+												<option key={option} value={option}>
+													{intl.formatMessage({ id: `api-token.expiry.${option}` })}
+												</option>
+											))}
+										</select>
+									</div>
+								</>
+							)}
+							<p className="small text-secondary mb-0">
+								<T id="api-token.revoke" />
+							</p>
+						</>
+					)}
+				</Modal.Body>
+				<Modal.Footer>
+					{result ? (
+						<Button actionType="primary" className="ms-auto" onClick={remove}>
+							<T id="api-token.done" />
+						</Button>
+					) : (
+						<>
+							<Button onClick={remove} disabled={isSubmitting}>
+								<T id="cancel" />
+							</Button>
+							<Button
+								type="submit"
+								actionType="primary"
+								className="ms-auto"
+								isLoading={isSubmitting}
+								disabled={isSubmitting || !currentUser}
+							>
+								<T id={challengeToken ? "login.2fa-verify" : "api-token.generate"} />
+							</Button>
+						</>
+					)}
+				</Modal.Footer>
+			</form>
+		</Modal>
+	);
+});
+
+export { showApiTokenModal };
